<link rel="stylesheet" href="/css/admin/partials/navbarAdmin.css">

<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm py-2">
  <div class="container-fluid justify-content-end px-4">
    <div class="d-flex align-items-center gap-3">

      <!-- Notification Icon -->
      <a href="/admin/notifications" class="position-relative notification-btn text-decoration-none">

        <i class="bi bi-bell fs-4"></i>

        <!-- Badge -->
        {{#if notificationCount}}
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
          {{notificationCount}}
        </span>
        {{/if}}
      </a>

      <!-- Profile Dropdown -->
      <div class="dropdown">
        <button class="btn d-flex align-items-center border-0 bg-transparent profile-btn" data-bs-toggle="dropdown"
          aria-expanded="false">

          <img src="{{admin.profileImage}}" alt="avatar" class="rounded-circle border profile-avatar"
            style="width:40px; height:40px;">

          <div class="text-start ms-2 d-none d-md-block">
            <span class="fw-semibold d-block text-dark" style="font-size: 0.95rem;">
              {{admin.name}}
            </span>
            <small class="text-muted" style="font-size: 0.8rem;">
              {{admin.email}}
            </small>
          </div>

          <i class="bi bi-chevron-down ms-2 text-secondary small"></i>
        </button>

        <!-- Dropdown Menu -->
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
          <li>
            <a class="dropdown-item" href="/admin/settings">
              <i class="bi bi-gear-fill me-2 text-primary"></i>Settings
            </a>
          </li>
          <li>
            <hr class="dropdown-divider">
          </li>
          <li>
            <button class="dropdown-item text-danger fw-semibold" type="button" data-bs-toggle="modal"
              data-bs-target="#logoutConfirmModal">
              <i class="bi bi-box-arrow-right me-2"></i>Logout
            </button>
          </li>
        </ul>
      </div>

    </div>
  </div>
</nav>

<!-- Logout Confirmation Modal -->
<div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">

      <div class="modal-header border-0">
        <h5 class="modal-title fw-semibold">
          Confirm Logout
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body text-center">
        <i class="bi bi-exclamation-triangle-fill text-warning fs-1 mb-3"></i>
        <p class="mb-0">
          Are you sure you want to logout?
        </p>
      </div>

      <div class="modal-footer border-0 justify-content-center">
        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">
          Cancel
        </button>

        <button type="button" class="btn btn-danger px-4" id="confirmLogoutBtn">
          Logout
        </button>
      </div>

    </div>
  </div>
</div>
<script>
  document
    .getElementById("confirmLogoutBtn")
    .addEventListener("click", () => {
      window.location.href = "/admin/logout";
    });
</script>