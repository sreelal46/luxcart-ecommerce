<style>
  /* Dropdown hover */
  .dropdown-menu .dropdown-item:hover {
    background-color: rgb(160, 160, 160);
    color: rgb(0, 0, 0);
  }

  .dropdown-menu .dropdown-item {
    transition: background-color 0.2s ease;
  }

  /* Custom Toggler */
  .custom-toggler {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 20px;
    padding: 0;
  }

  /* Mobile top bar: cart + hamburger pushed to the right */
  .mobile-top-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  .mobile-top-bar .mobile-cart {
    color: #fff;
    padding: 4px 6px;
  }

  @media (min-width: 992px) {
    .mobile-top-bar {
      display: none;
    }
  }

  .custom-toggler span {
    display: block;
    height: 2.5px;
    width: 100%;
    background-color: #fff;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* Toggler → X when open */
  .custom-toggler.is-open span:nth-child(1) {
    transform: translateY(8.75px) rotate(45deg);
  }

  .custom-toggler.is-open span:nth-child(2) {
    opacity: 0;
  }

  .custom-toggler.is-open span:nth-child(3) {
    transform: translateY(-8.75px) rotate(-45deg);
  }


  /* Desktop-only actions */
  .desktop-actions {
    display: none;
  }

  @media (min-width: 992px) {
    .desktop-actions {
      display: flex;
    }
  }

  /* Nav-link icons — mobile only */
  .nav-link .nav-icon {
    display: none;
  }

  @media (max-width: 991px) {
    .nav-link .nav-icon {
      display: inline-block;
      width: 18px;
      text-align: center;
      margin-right: 10px;
    }

    .navbar-nav .nav-link {
      padding: 10px 16px;
      font-size: 1.1rem;
    }
  }
</style>

<header>
  <nav class="navbar navbar-expand-lg navbar-dark fixed-top py-1"
    style="background: rgba(0,0,0,0.2); backdrop-filter: blur(10px);">
    <div class="container-fluid">

      <!-- Brand -->
      <a class="navbar-brand fw-medium fs-3 text-white" href="#home">LuxCart</a>

      <!-- Mobile top bar: Cart + Hamburger (hidden on desktop) -->
      <div class="mobile-top-bar">
        {{#if user}}
        <a href="/cart" class="btn btn-outline-light border border-0 btn-sm mobile-cart">
          <i class="bi bi-cart fs-3"></i>
        </a>
        {{/if}}

        <!-- Hamburger -->
        <button class="custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
          aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

      <!-- Collapsible Nav Links -->
      <div class="collapse navbar-collapse" id="mainNavbar">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fs-5">
          <li class="nav-item">
            <a class="nav-link text-white px-3" href="/">
              <i class="bi bi-house nav-icon"></i>Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white px-3" href="/cars-collection">
              <i class="bi bi-car-front nav-icon"></i>Cars
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white px-3" href="/all-accessories">
              <i class="bi bi-gem nav-icon"></i>Accessories
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white px-3" href="/contact">
              <i class="bi bi-envelope nav-icon"></i>Contact
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link text-white px-3" href="/about">
              <i class="bi bi-info-circle nav-icon"></i>About Us
            </a>
          </li>

          {{#if user}}
          <!-- Divider — mobile only -->
          <li class="nav-item d-lg-none">
            <hr class="border-secondary my-1 mx-3">
          </li>
          <!-- Account links — mobile only, with icons -->
          <li class="nav-item d-lg-none">
            <a class="nav-link text-white px-3" href="/account">
              <i class="bi bi-person-circle nav-icon"></i>Account
            </a>
          </li>
          <li class="nav-item d-lg-none">
            <a class="nav-link text-white px-3" href="/account/wishlist">
              <i class="bi bi-heart nav-icon"></i>Wishlist
            </a>
          </li>
          <li class="nav-item d-lg-none">
            <a class="nav-link text-danger px-3" href="/logout">
              <i class="bi bi-box-arrow-right nav-icon"></i>Logout
            </a>
          </li>
          {{/if}}
        </ul>
      </div>

      <!-- Desktop-only: Cart + Profile Dropdown -->
      <div class="desktop-actions gap-3 align-items-center">
        {{#if user}}
        <a href="/cart" class="btn btn-outline-light border border-0 btn-md">
          <i class="bi bi-cart fs-5"></i>
        </a>
        <div class="dropdown">
          <button class="btn btn-outline-light btn-md border border-0 dropdown-toggle d-flex align-items-center"
            type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person fs-5"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="profileDropdown"
            style="backdrop-filter: blur(10px); background: rgba(0,0,0,0.5); margin-top: 15px;">
            <li class="px-3 py-2 text-white">
              <strong>{{user.name}}</strong><br>
              <small>{{user.email}}</small>
            </li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <li><a class="dropdown-item d-flex align-items-center text-white" href="/account">
                <i class="bi bi-person-circle me-2"></i> Account</a></li>
            <li><a class="dropdown-item d-flex align-items-center text-white" href="/account/wishlist">
                <i class="bi bi-heart me-2"></i> Wishlist</a></li>
            <li><a class="dropdown-item d-flex align-items-center text-danger" href="/logout">
                <i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
          </ul>
        </div>
        {{else}}
        <a href="/login" class="btn btn-outline-light btn-md border border-0">Login</a>
        <a href="/signup" class="btn btn-outline-light btn-md border border-0">Sign Up</a>
        {{/if}}
      </div>

    </div>
  </nav>
</header>

<script>
  const navbar = document.querySelector("#mainNavbar");
  const toggler = document.querySelector(".custom-toggler");

  navbar.addEventListener("shown.bs.collapse", () => toggler.classList.add("is-open"));
  navbar.addEventListener("hidden.bs.collapse", () => toggler.classList.remove("is-open"));

  document.addEventListener("click", function (event) {
    if (
      navbar.classList.contains("show") &&
      !navbar.contains(event.target) &&
      !toggler.contains(event.target)
    ) {
      bootstrap.Collapse.getInstance(navbar).hide();
    }
  });
</script>