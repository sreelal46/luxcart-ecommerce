<link rel="stylesheet" href="/css/user/partials/userAccountSidebar.css">
<div class="col-lg-3 sidebar">
  <aside class="account-sidebar">
    <div class="user-info">
      <div class="avatar">
        <img id="sidebarAvatar" src="{{user.profileImage_url}}" alt="avatar">
      </div>

      <div>
        <div style="font-weight:600" id="sidebarName">{{user.name}}</div>
        <div style="font-size:13px;color:var(--muted)" id="sidebarEmail">{{user.email}}</div>
      </div>
    </div>

    <nav class="nav flex-column nav-acc">
      <a class="nav-link" href="/account/profile"><i class="bi bi-person-circle me-2"></i> Profile</a>
      <a class="nav-link" href="/account/orders"><i class="bi bi-journal-check me-2"></i> Orders</a>
      <a class="nav-link" href="/account/wishlist"><i class="bi bi-heart me-2"></i> Wishlist</a>
      <a class="nav-link" href="/account/addresses"><i class="bi bi-geo-alt me-2"></i> Addresses</a>
      <a class="nav-link" href="/account/wallet"><i class="bi bi-wallet2 me-2"></i> Wallet</a>
      {{#if (eq user.authProvider "local")}}
      <a class="nav-link" href="/account/change-password"><i class="bi bi-key me-2"></i> Change Password</a>
      {{/if}}
      <a class="nav-link" href="/account/referrals"><i class="bi bi-people me-2"></i> Referrals</a>
      <a class="nav-link" href="#" id="logoutLink"><i class="bi bi-box-arrow-right me-2"></i> Logout</a>
    </nav>
  </aside>
</div>

<!-- Logout Confirmation Modal -->
<div class="modal-overlay" id="logoutModal">
  <div class="modal-container">
    <!-- <div class="modal-icon-wrapper warning">
      <div class="modal-icon">⚠️</div>
    </div> -->
    <h5 class="modal-title warning">Confirm Logout</h5>
    <p class="modal-message">Are you sure you want to logout from your account?</p>
    <div class="modal-buttons">
      <button class="modal-btn cancel" onclick="closeLogoutModal()">Cancel</button>
      <button class="modal-btn confirm" onclick="confirmLogout()">Logout</button>
    </div>
  </div>
</div>

<script src="/js/user/partials/userAccountSidebar.js"></script>