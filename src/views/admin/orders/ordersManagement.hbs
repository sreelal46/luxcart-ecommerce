<link rel="stylesheet" href="/css/admin/orders/ordersManagement.css">
<div class="container py-5">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Orders Management</h2>
    <div class="d-flex">
      <a href="/admin/orders-management/cancel-request-management">
        <button class="btn btn-cancel btn-md me-2 shadow-sm">
          <i class="bi bi-x-circle me-2"></i> Cancel Requests
        </button>
      </a>

      <a href="/admin/orders-management/return-request-management">
        <button class="btn btn-return btn-md me-2 shadow-sm">
          <i class="bi bi-arrow-repeat me-2"></i> Return Requests
        </button>
      </a>
    </div>
  </div>

  <!-- Search & Filter -->
  <div class="d-flex justify-content-between mb-3">
    <input type="text" id="searchOrderInput" class="form-control w-50"
      placeholder="Search by Order ID, Customer, Product">
    <button class="btn btn-primary ms-2" data-bs-toggle="modal" data-bs-target="#filterOrderModal">
      <i class="bi bi-funnel"></i> Filter
    </button>
  </div>

  <!-- Orders Table Card -->
  <div class="card shadow-sm mb-3 border-0">
    <div class="card-body table-responsive p-0">
      <table class="table table-hover align-middle mb-0 admin-table">
        <thead class="table-light">
          <tr>
            <th>#</th>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Date</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>

        <tbody id="ordersTableBody">
          {{#each orders}}
          <tr>
            <td class="fw-semibold text-muted">{{inc @index}}</td>
            <td class="fw-semibold text-muted small">{{this.orderId}}</td>
            <td class="fw-semibold text-dark">{{this.address.name}}</td>
            <td class="text-muted">{{this.items.length}}</td>
            <td class="text-nowrap text-muted">{{formattedDate this.createdAt}}</td>
            <td class="text-center">
              <div class="d-flex justify-content-center align-items-center gap-2">
                <div data-bs-toggle="tooltip" title="View order">
                  <a href="/admin/orders-management/view-order/{{this._id}}" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-eye"></i> View
                  </a>
                </div>
              </div>
            </td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              No Orders Found
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="pagination-container"></div>

  <!-- Hidden data for initial pagination -->
  <script id="initialData" type="application/json">
    {
      "totalPages": {{totalPages}},
      "currentPage": {{currentPage}}
    }
  </script>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterOrderModal" tabindex="-1" aria-labelledby="filterOrderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-3">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="filterOrderModalLabel">
          <i class="bi bi-funnel me-2"></i> Filter Orders
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="filterOrderForm">
          <div class="mb-3">
            <label class="form-label fw-semibold">Payment Method</label>
            <select class="form-select" name="paymentMethod">
              <option value="">All</option>
              <option value="COD">Cash on Delivery</option>
              <option value="STRIPE">Stripe</option>
              <option value="CARD">Card</option>
              <option value="NETBANKING">Net Banking</option>
              <option value="WALLET">Wallet</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Payment Status</label>
            <select class="form-select" name="paymentStatus">
              <option value="">All</option>
              <option value="Pending">Pending</option>
              <option value="Paid">Paid</option>
              <option value="Partially Paid">Partially Paid</option>
              <option value="Failed">Failed</option>
              <option value="Refunded">Refunded</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Item Status</label>
            <select class="form-select" name="itemStatus">
              <option value="">All</option>
              <option value="placed">Placed</option>
              <option value="confirmed">Confirmed</option>
              <option value="shipped">Shipped</option>
              <option value="out_for_delivery">Out for Delivery</option>
              <option value="delivered">Delivered</option>
              <option value="cancelled">Cancelled</option>
              <option value="returned">Returned</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Date From</label>
            <input type="date" class="form-control" name="dateFrom">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Date To</label>
            <input type="date" class="form-control" name="dateTo">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Min Amount (₹)</label>
            <input type="number" class="form-control" name="minAmount" placeholder="e.g. 1000">
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Max Amount (₹)</label>
            <input type="number" class="form-control" name="maxAmount" placeholder="e.g. 100000">
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button class="btn btn-outline-danger" id="clearFilter">Clear Filters</button>
        <button class="btn btn-primary" id="applyFilter">Apply Filter</button>
      </div>
    </div>
  </div>
</div>
<script src="/js/admin/orders/ordersManagement.js"></script>