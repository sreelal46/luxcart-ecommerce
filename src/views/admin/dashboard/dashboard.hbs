<link rel="stylesheet" href="/css/admin/dashboard.css">

<!-- HEADER -->
<div class="d-flex justify-content-between align-items-center pt-4 pb-3">
  <div>
    <h2 class="fw-bold">Dashboard</h2>
    <span class="text-muted">Welcome back, {{username}} 👋</span>
  </div>
</div>

<!-- STATS -->
<div class="row g-4 mb-4">
  <div class="col-md-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body text-center">
        <div class="icon-circle bg-primary mb-2">
          <i class="bi bi-currency-rupee text-white fs-4"></i>
        </div>
        <h6 class="text-muted">Today's Sales</h6>
        <h4 class="fw-bold">{{#if todaysSales}}₹ {{formatPrice todaysSales}}{{else}}₹ 0{{/if}}</h4>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body text-center">
        <div class="icon-circle bg-info mb-2">
          <i class="bi bi-bar-chart text-white fs-4"></i>
        </div>
        <h6 class="text-muted">Monthly Revenue</h6>
        <h4 class="fw-bold">₹ {{formatPrice monthlyRevenue}}</h4>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body text-center">
        <div class="icon-circle bg-warning mb-2">
          <i class="bi bi-bag-check text-white fs-4"></i>
        </div>
        <h6 class="text-muted">Total Orders</h6>
        <h4 class="fw-bold">{{totalOrders}}</h4>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card stat-card border-0 shadow-sm">
      <div class="card-body text-center">
        <div class="icon-circle bg-success mb-2">
          <i class="bi bi-people text-white fs-4"></i>
        </div>
        <h6 class="text-muted">Total Users</h6>
        <h4 class="fw-bold">{{totalUsers}}</h4>
      </div>
    </div>
  </div>
</div>

<!-- REVENUE CHART -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold">Revenue Overview</h5>
      <div class="btn-group btn-group-sm" role="group">
        <button type="button" class="btn btn-outline-primary active" data-filter="yearly">Yearly</button>
        <button type="button" class="btn btn-outline-primary" data-filter="monthly">Monthly</button>
        <button type="button" class="btn btn-outline-primary" data-filter="weekly">Weekly</button>
        <button type="button" class="btn btn-outline-primary" data-filter="daily">Daily</button>
      </div>
    </div>
    <canvas id="revenueChart" height="80"></canvas>
  </div>
</div>

<!-- ANALYTICS TABS -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <ul class="nav nav-tabs mb-3" id="analyticsTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active" id="products-tab" data-bs-toggle="tab" data-bs-target="#products" type="button">
          Top Products
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="categories-tab" data-bs-toggle="tab" data-bs-target="#categories" type="button">
          Top Categories
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="brands-tab" data-bs-toggle="tab" data-bs-target="#brands" type="button">
          Top Brands
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link" id="ledger-tab" data-bs-toggle="tab" data-bs-target="#ledger" type="button">
          Ledger Book
        </button>
      </li>
    </ul>

    <div class="tab-content" id="analyticsTabContent">
      <!-- TOP PRODUCTS -->
      <div class="tab-pane fade show active" id="products" role="tabpanel">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Product Name</th>
                <th>Brand</th>
                <th>Type</th>
                <th class="text-center">Units Sold</th>
                <th class="text-end">Revenue</th>
              </tr>
            </thead>
            <tbody id="topProductsTable">
              <tr>
                <td colspan="6" class="text-center">
                  <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TOP CATEGORIES -->
      <div class="tab-pane fade" id="categories" role="tabpanel">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Category Name</th>
                <th>Product Type</th>
                <th class="text-center">Units Sold</th>
                <th class="text-center">Orders</th>
                <th class="text-end">Revenue</th>
              </tr>
            </thead>
            <tbody id="topCategoriesTable">
              <tr>
                <td colspan="6" class="text-center">
                  <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- TOP BRANDS -->
      <div class="tab-pane fade" id="brands" role="tabpanel">
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Brand Name</th>
                <th>Country</th>
                <th class="text-center">Units Sold</th>
                <th class="text-center">Orders</th>
                <th class="text-end">Revenue</th>
              </tr>
            </thead>
            <tbody id="topBrandsTable">
              <tr>
                <td colspan="6" class="text-center">
                  <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- LEDGER BOOK -->
      <div class="tab-pane fade" id="ledger" role="tabpanel">
        <div class="row mb-3">
          <div class="col-md-4">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-control" id="ledgerStartDate">
          </div>
          <div class="col-md-4">
            <label class="form-label">End Date</label>
            <input type="date" class="form-control" id="ledgerEndDate">
          </div>
          <div class="col-md-4 d-flex align-items-end">
            <button class="btn btn-primary w-100" id="generateLedgerBtn">
              <i class="bi bi-file-earmark-text me-2"></i>Generate Ledger
            </button>
          </div>
        </div>

        <div id="ledgerSummary" class="row g-3 mb-3" style="display: none;">
          <div class="col-md-4">
            <div class="card bg-light">
              <div class="card-body text-center">
                <small class="text-muted">Total Orders</small>
                <h5 class="mb-0" id="ledgerTotalOrders">0</h5>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card bg-light">
              <div class="card-body text-center">
                <small class="text-muted">Total Revenue</small>
                <h5 class="mb-0" id="ledgerTotalRevenue">₹0</h5>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card bg-light">
              <div class="card-body text-center">
                <small class="text-muted">Pending Amount</small>
                <h5 class="mb-0" id="ledgerPending">₹0</h5>
              </div>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-hover table-sm">
            <thead class="table-light">
              <tr>
                <th>Date</th>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Product</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Total</th>
                <th>Payment</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="ledgerTable">
              <tr>
                <td colspan="9" class="text-center text-muted">
                  Select date range and click "Generate Ledger"
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="text-end mt-3">
          <!-- <button class="btn btn-success" id="downloadLedgerBtn" style="display: none;">
            <i class="bi bi-download me-2"></i>Download as Excel
          </button> -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- RECENT ORDERS -->
<div class="card border-0 shadow-sm">
  <div class="card-body">
    <div class="d-flex justify-content-between mb-3">
      <h5 class="fw-bold">Recent Orders</h5>
      <a href="/admin/sales-report" class="small fw-semibold">View All</a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover admin-table">
        <thead class="table-light">
          <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Product</th>
            <th>Date</th>
            <th class="text-end">Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
          <tr>
            <td class="fw-semibold text-muted">#{{orderId}}</td>
            <td class="fw-semibold">{{customer}}</td>
            <td class="text-muted">{{product}}</td>
            <td class="text-muted">{{date}}</td>
            <td class="fw-semibold text-end">₹ {{formatPrice amount}}</td>
            <td>
              {{#if (eq status "Paid")}}
              <span class="badge bg-success-subtle text-success">Paid</span>
              {{else if (eq status "Partially Paid")}}
              <span class="badge bg-warning-subtle text-warning">Partial</span>
              {{else}}
              <span class="badge bg-secondary-subtle text-secondary">Pending</span>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="/js/admin/dashboard.js"></script>