<link rel="stylesheet" href="/css/user/landingPage.css">


<!-- Hero Section -->
<section class="hero-section position-relative text-center text-white">
  <!-- Fallback Image (shows if video fails or not supported) -->
  <div class="hero-fallback w-100 h-100"
    style="background: url('https://images.unsplash.com/photo-1613921568536-555645be4032?q=80&w=1122&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D') center/cover no-repeat; position: absolute; top: 0; left: 0;">
  </div>

  <!-- Video Background -->
  <video id="heroVideo" muted loop playsinline class="hero-video w-100 h-100"
    style="object-fit: cover; opacity: 0; transition: opacity 0.5s ease-in-out; position: relative; z-index: 1;"
    poster="https://images.unsplash.com/photo-1613921568536-555645be4032?q=80&w=1122&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
    oncanplaythrough="this.style.opacity='1'; this.play();" onerror="this.style.display='none';">
    <source src="{{defaultBanner.url}}" type="video/mp4">
  </video>

  <!-- Overlay -->
  <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0,0,0,0.5); z-index: 2;"></div>

  <!-- Hero Section Text -->
  <div class="hero-content position-absolute text-center" style="z-index: 3;">
    <h1 class="hero-title display-3 fw-bold text-white hero-text">Automotive</h1>
    <p class="hero-subtitle lead text-white hero-text">
      Experience the epitome of luxury and performance with our curated collection of exceptional automobiles.
    </p>
    <a href="/cars-collection" class="btn btn-outline-light rounded-pill mt-3 hero-btn">Cars</a>
    <a href="/all-accessories" class="btn btn-outline-light rounded-pill mt-3 hero-btn">Accessory</a>
  </div>
</section>


<!-- Premium Brands -->
<section class="premium-brands py-5 bg-light text-center">
  <h2 class="fw-bold fs-1 mb-4">Our Premium Brands</h2>

  <div class="brand-slider overflow-hidden">
    <div class="brand-slide-track">
      {{#each brands}}
      <img src="{{this.image_url}}" alt="{{this.name}}" class="brand-logo" />
      {{/each}}
      {{!-- Duplicate for seamless infinite loop --}}
      {{#each brands}}
      <img src="{{this.image_url}}" alt="{{this.name}}" class="brand-logo" />
      {{/each}}
    </div>
  </div>
</section>




<!-- Featured Categories -->
<section class="featured-categories py-5 bg-light" id="featured-categories">
  <div class="container-fluid text-center px-4">
    <h2 class="fw-bold display-5 mb-3">Featured Categories</h2>
    <p class="text-muted mb-5">
      Discover our handpicked selection of exceptional automobiles and accessories.
    </p>

    <div class="row g-3 justify-content-center">
      <!-- Luxury Cars -->
      <div class="col-lg-4 col-md-6">
        <a href="/cars-collection" style="text-decoration: none;">
          <div class="category-card card border-0 text-white overflow-hidden position-relative">
            <img src="https://c.animaapp.com/mgkggbftOxjBCn/img/hakon-sataoen-qyfco1nfmtg-unsplash-2.png"
              class="card-img" alt="Luxury Cars">
            <div class="overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4">
              <h5 class="fw-bold">{{types.[0].name}}</h5>
              <p class="mb-0">Explore Collection
              </p>
            </div>
          </div>
        </a>
      </div>

      <!-- Performance -->
      <div class="col-lg-4 col-md-6">
        <a href="/cars-collection" style="text-decoration: none;">
          <div class="category-card card border-0 text-white overflow-hidden position-relative">
            <img src="https://images.unsplash.com/photo-1502877338535-766e1452684a?auto=format&fit=crop&w=800&q=80"
              class="card-img" alt="Performance Cars">
            <div class="overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4">
              <h5 class="fw-bold">{{types.[1].name}}</h5>
              <p class="mb-0">Explore Collection
              </p>
            </div>
          </div>
        </a>
      </div>

      <!-- Limited Edition -->
      <div class="col-lg-4 col-md-6">
        <a href="/cars-collection" style="text-decoration: none;">
          <div class="category-card card border-0 text-white overflow-hidden position-relative">
            <img src="https://c.animaapp.com/mgkggbftOxjBCn/img/01-lvn-34-front-1.png" class="card-img"
              alt="Limited Edition">
            <div class="overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4">
              <h5 class="fw-bold">{{types.[2].name}}</h5>
              <p class="mb-0">Explore Collection
              </p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Premium Accessories -->
<section class="premium-accessories py-5 bg-light" id="premium-accessories">
  <div class="container-fluid px-4 px-md-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap text-center text-md-start">
      <h2 class="fw-bold display-6 mb-5 mb-md-0">Premium Accessories</h2>
      <a href="/all-accessories" class="text-decoration-none fw-semibold text-dark hover-link">
        View All <img src="https://c.animaapp.com/mgkggbftOxjBCn/img/frame-2.svg" width="16" alt="arrow">
      </a>
    </div>

    <div class="row g-4 justify-content-center">
      <!-- Accessory 1 -->
      {{#each accessories}}
      <a href="/all-accessories/view-accessory-product/{{this._id}}" class="col-12 col-sm-6 col-md-4 col-lg-3"
        style="text-decoration: none;">

        <div class="accessory-card card border-0 shadow-sm h-100 position-relative">

          {{!-- OFFER BADGE --}}
          {{#if this.appliedOffer}}
          <span class="badge bg-success position-absolute top-0 start-0 m-2">
            {{#if (eq this.appliedOffer.discountType "Percentage")}}
            {{this.appliedOffer.discountValue}}% OFF
            {{else}}
            ₹{{this.appliedOffer.discountValue}} OFF
            {{/if}}
          </span>
          {{/if}}

          {{!-- OUT OF STOCK BADGE --}}
          {{#if (eq this.stock 0)}}
          <span class="badge bg-danger position-absolute top-0 end-0 m-2">
            Out of Stock
          </span>
          {{/if}}

          <img src="{{this.images.[0]}}" class="card-img-top {{#if (eq this.stock 0)}}opacity-50{{/if}}"
            alt="{{this.name}}">

          <div class="card-body text-center">
            <h6 class="fw-bold">{{this.name}}</h6>
            <p class="text-muted small">{{this.product_type_id.name}}</p>

            {{!-- PRICE SECTION --}}
            {{#if this.appliedOffer}}
            <p class="mb-0">
              <span class="text-muted text-decoration-line-through small">
                ₹ {{formatPrice this.price}}
              </span>
            </p>
            <p class="fw-bold text-success mb-0">
              ₹ {{formatPrice this.offerPrices.finalPrice}}
            </p>
            {{else}}
            <p class="fw-bold text-dark mb-0">
              ₹ {{formatPrice this.price}}
            </p>
            {{/if}}

          </div>

        </div>
      </a>
      {{/each}}
    </div>
  </div>
</section>


