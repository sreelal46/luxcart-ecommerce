<link rel="stylesheet" href="/css/user/contactUs.css">

<div class="container py-5">

  <div class="mb-4">
    <h2 class="fw-bold mt-5">Contact Us</h2>
    <p class="text-muted">
      Have a question about our vehicles or services? Our team is here to help.
    </p>
  </div>

  <div class="row g-4">

    <!-- LEFT -->
    <div class="col-lg-4">
      <div class="card contact-card p-4 h-100">
        <h5 class="fw-semibold mb-4">Get In Touch</h5>

        <div class="d-flex mb-3">
          <div class="icon-box me-3"><i class="bi bi-geo-alt"></i></div>
          <div>
            <strong>Our Location</strong>
            <p class="mb-0 text-muted">{{footer.address.street}}<br>{{footer.address.city}}</p>
          </div>
        </div>

        <div class="d-flex mb-3">
          <div class="icon-box me-3"><i class="bi bi-telephone"></i></div>
          <div>
            <strong>Phone</strong>
            <p class="mb-0 text-muted">{{footer.phone}}</p>
          </div>
        </div>

        <div class="d-flex mb-4">
          <div class="icon-box me-3"><i class="bi bi-envelope"></i></div>
          <div>
            <strong>Email</strong>
            <p class="mb-0 text-muted">{{footer.email}}</p>
          </div>
        </div>

        <strong class="mb-2 d-block">Follow Us</strong>
        <div class="social-icons">
          <a href="#"><i class="bi bi-facebook"></i></a>
          <a href="#"><i class="bi bi-instagram"></i></a>
          <a href="#"><i class="bi bi-twitter"></i></a>
          <a href="#"><i class="bi bi-linkedin"></i></a>
        </div>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="col-lg-8">
      <div class="card contact-card p-4 h-100">
        <h5 class="fw-semibold mb-4">Send Us a Message</h5>

        <form id="contactForm" class="needs-validation" novalidate>
          <div class="row g-3">

            <div class="col-md-6">
              <label class="form-label">Full Name</label>
              <input type="text" class="form-control" name="name" required>
              <div class="invalid-feedback">Full name is required.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="email" required>
              <div class="invalid-feedback">Enter a valid email.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label">Phone (optional)</label>
              <input type="text" class="form-control" name="phone">
            </div>

            <div class="col-md-6">
              <label class="form-label">Subject</label>
              <input type="text" class="form-control" name="subject" required>
              <div class="invalid-feedback">Subject is required.</div>
            </div>

            <div class="col-12">
              <label class="form-label">Message</label>
              <textarea class="form-control" rows="4" name="message" required minlength="10"></textarea>
              <div class="invalid-feedback">Minimum 10 characters required.</div>
            </div>

            <div class="col-12 text-end">
              <button type="submit" class="btn btn-dark px-4" id="submitBtn">
                <span id="btnText">Send Message</span>
                <span id="btnLoader" class="spinner-border spinner-border-sm d-none"></span>
              </button>
            </div>

          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="mt-5">
    <h5 class="fw-semibold mb-3">Our Location</h5>
    <div class="map-box">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2660.546019057556!2d11.554225687571732!3d48.17683029711261!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x479e768087170bad%3A0x72c8c041bfc2d37e!2sBMW%20Headquarters%2C%20Am%20Olympiapark%202%2C%2080809%20M%C3%BCnchen%2C%20Germany!5e0!3m2!1sen!2sin!4v1770228428461!5m2!1sen!2sin"
        loading="lazy"></iframe>
    </div>
  </div>
</div>

<!-- SUCCESS MODAL -->
<div class="modal fade" id="successModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content text-center p-4">
      <i class="bi bi-check-circle-fill text-success fs-1 mb-3"></i>
      <h5>Message Sent!</h5>
      <p class="text-muted">We’ll contact you shortly.</p>
      <button class="btn btn-dark" data-bs-dismiss="modal">OK</button>
    </div>
  </div>
</div>
<!-- ERROR MODAL -->
<div class="modal fade" id="errorModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content text-center p-4">
      <i class="bi bi-x-circle-fill text-danger fs-1 mb-3"></i>
      <h5 class="fw-semibold">Message Failed</h5>
      <p class="text-muted" id="errorModalText">
        Something went wrong. Please try again later.
      </p>
      <button class="btn btn-dark" data-bs-dismiss="modal">OK</button>
    </div>
  </div>
</div>
<script src="/js/user/contactUs.js"></script>