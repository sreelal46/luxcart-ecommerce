<link rel="stylesheet" href="/css/user/account/wallet.css">

<div class="container py-4">
  <h4 class="fw-bold mb-4">My Wallet</h4>

  <!-- ================= WALLET OVERVIEW ================= -->
  <div id="section-wallet" class="section active">
    <div class="card mb-4">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <small class="text-muted">Available Balance</small>
          <h3 class="fw-bold" id="balance">
            ₹{{#if wallet.balance}}{{formatPrice wallet.balance}}{{else}}0.00{{/if}}
          </h3>
        </div>
        <button class="btn btn-dark" onclick="showSection('add')">
          + Add Money
        </button>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <h6 class="fw-bold mb-3">Transaction History</h6>
        {{#if wallet.transactionHistory.length}}
        <div class="table-responsive">
          <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
              <tr>
                <th>Date</th>
                <th>Message</th>
                <th>Type</th>
                <th>Flow</th>
                <th class="text-end">Amount</th>
              </tr>
            </thead>
            <tbody>
              {{#each wallet.transactionHistory}}
              <tr>
                <td>{{formattedDate this.date}}</td>
                <td>{{#if this.message}}{{this.message}}{{else}}N/A{{/if}}</td>
                <td class="text-capitalize">{{replaceUnderscore this.type}}</td>
                <td>
                  {{#if (eq this.flow "credit")}}
                  <span class="badge bg-success">Credit</span>
                  {{else}}
                  <span class="badge bg-danger">Debit</span>
                  {{/if}}
                </td>
                <td class="text-end fw-bold">
                  {{#if (eq this.flow "credit")}}
                  <span class="text-success">+₹{{formatPrice this.amount}}</span>
                  {{else}}
                  <span class="text-danger">-₹{{formatPrice this.amount}}</span>
                  {{/if}}
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        {{else}}
        <div class="empty-transactions">
          <div class="empty-transactions__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="5" width="20" height="14" rx="2" />
              <line x1="2" y1="10" x2="22" y2="10" />
            </svg>
          </div>
          <h6>No transactions yet</h6>
          <p>Your wallet activity will show up here once you make your first purchase.</p>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- ================= ADD AMOUNT ================= -->
  <div id="section-add" class="section">
    <div class="card">
      <div class="card-body">
        <button class="btn btn-link text-dark mb-3 p-0" onclick="showSection('wallet')">
          <i class="bi bi-arrow-left"></i> Back
        </button>
        <h6 class="fw-bold mb-3">Add Money</h6>

        <!-- Quick amount buttons -->
        <div class="mb-3">
          <small class="text-muted d-block mb-2">Quick Select</small>
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-dark" onclick="setAmount(500)">₹500</button>
            <button class="btn btn-outline-dark" onclick="setAmount(1000)">₹1000</button>
            <button class="btn btn-outline-dark" onclick="setAmount(2000)">₹2000</button>
            <button class="btn btn-outline-dark" onclick="setAmount(5000)">₹5000</button>
          </div>
        </div>

        <input type="number" id="amountInput" class="form-control mb-3" placeholder="Enter amount" min="1">
        <small class="text-muted">Minimum amount: ₹1</small>

        <div class="text-end mt-3">
          <button class="btn btn-outline-secondary" onclick="showSection('wallet')">Cancel</button>
          <button class="btn btn-dark" onclick="validateAndContinue()">Continue</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= PAYMENT METHOD ================= -->
  <div id="section-payment" class="section">
    <div class="card">
      <div class="card-body">
        <button class="btn btn-link text-dark mb-3 p-0" onclick="showSection('add')">
          <i class="bi bi-arrow-left"></i> Back
        </button>
        <h6 class="fw-bold mb-3">Payment Method</h6>

        <div class="payment-card mb-3 selected">
          <div class="d-flex align-items-center">
            <i class="bi bi-credit-card fs-4 me-3"></i>
            <div>
              <strong>Stripe Payment</strong>
              <div class="text-muted small">Pay securely via Stripe</div>
            </div>
          </div>
        </div>

        <div class="alert alert-info">
          <i class="bi bi-info-circle"></i>
          <small>Amount to pay: <strong id="payAmount">₹0</strong></small>
        </div>

        <div class="text-end">
          <button class="btn btn-outline-secondary" onclick="showSection('add')">Back</button>
          <button class="btn btn-dark" onclick="processPayment()" id="payBtn">
            <span id="payBtnText">Pay Now</span>
            <span id="payBtnSpinner" class="spinner-border spinner-border-sm ms-2" style="display: none;"></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= PAYMENT SUCCESS ================= -->
  <div id="section-success" class="section">
    <div class="card">
      <div class="card-body text-center py-5">
        <div class="mb-4">
          <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
        </div>
        <h5 class="fw-bold mb-2">Payment Successful!</h5>
        <p class="text-muted mb-4">Money has been added to your wallet</p>
        <button class="btn btn-dark" onclick="window.location.href='/account/wallet'">View Wallet</button>
      </div>
    </div>
  </div>

  <!-- ================= PAYMENT CANCELLED ================= -->
  <div id="section-cancel" class="section">
    <div class="card">
      <div class="card-body text-center py-5">
        <div class="mb-4">
          <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
        </div>
        <h5 class="fw-bold mb-2">Payment Cancelled</h5>
        <p class="text-muted mb-4">Your payment was cancelled</p>
        <button class="btn btn-dark" onclick="showSection('wallet')">Back to Wallet</button>
      </div>
    </div>
  </div>

</div>
<!-- Stripe JS -->
<script src="https://js.stripe.com/v3/"></script>
<script src="/js/user/account/wallet.js"></script>