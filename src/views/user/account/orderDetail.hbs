<link rel="stylesheet" href="/css/user/account/orderDetail.css">


<div class="wrap-orderdetail">

  <!-- HEADER -->
  <div class="order-header">
    <div>
      <h3 class="page-title">Order Details</h3>
      <small class="text-muted">Order ID: {{order.orderId}}</small>
    </div>

    <button id="downloadInvoice" class="btn-invoice" data-orderid="{{order._id}}" data-orderedid="{{order.orderId}}"
      data-customername="{{order.address.name}}">
      <span class="btn-text">
        <i class="bi bi-receipt"></i> Invoice
      </span>

      <span class="btn-loader d-none">
        <i class="bi bi-arrow-repeat spin"></i> Downloading...
      </span>
    </button>

  </div>

  <!-- STICKY SUMMARY -->
  <div class="order-summary-box">
    <!-- <div>
      <div class="os-label">Order ID</div>
      <div class="os-value">{{order.orderId}}</div>
    </div> -->

    <div>
      <div class="os-label">Date</div>
      <div class="os-value">{{formattedDate order.createdAt}}</div>
    </div>

    <div>
      <div class="os-label">Total</div>
      <span class="os-value">
        ₹ {{#if order.totalAmount}}
        {{formatPrice order.totalAmount}}
        {{else}}
        0
        {{/if}}
      </span>
    </div>

    <!-- <div>
      <div class="os-label">Total Advance Amount</div>
      <span class="os-value">
        ₹ {{#if order.advanceAmount}}
        {{formatPrice order.advanceAmount}}
        {{else}}
        0
        {{/if}}
      </span>
    </div> -->
    {{#if order.remainingAmount}}
    <div>
      <div class="os-label">Remaining Amount</div>
      <span class="os-value">
        ₹ {{formatPrice order.remainingAmount}}
      </span>
    </div>
    {{/if}}

    {{#if order.totalRefundAmount}}
    <div>
      <div class="os-label">Total Refund Amount</div>
      <span class="os-value">
        ₹ {{formatPrice order.totalRefundAmount}}
      </span>
    </div>
    {{/if}}
  </div>

  <!-- ADDRESS -->
  <h5 class="section-title">Shipping Address</h5>
  <div class="address-box">
    <strong>{{order.address.name}}</strong><br>
    {{order.address.phone}} • {{order.address.email}}<br><br>
    {{order.address.label}}<br>
    {{order.address.street}}<br>
    {{#if order.address.landmark}}{{order.address.landmark}}<br>{{/if}}
    {{order.address.city}}, {{order.address.district}},
    {{order.address.state}} – {{order.address.pincode}}
  </div>
  <div id="stripe-box" style="display:none;">
    <h5 class="mt-3">Secure Payment</h5>

    <!-- Amount Display -->
    <div style="background:#f8f9ff; border:2px solid #5469d4; border-radius:8px; padding:15px; margin-bottom:20px;">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <span style="font-size:16px; color:#666;">Amount to Pay:</span>
        <span style="font-size:24px; font-weight:700; color:#5469d4;" id="stripe-amount">₹0</span>
      </div>
    </div>

    <div id="payment-element"></div>
    <button id="stripe-submit-btn" type="button">
      <span id="btn-text">Pay Now</span>
      <span id="btn-amount" style="margin-left:10px; font-weight:700;"></span>
    </button>
  </div>

  {{!-- Complete Payment Section --}}
  <div class="card payment-card shadow-sm">
    <div class="card-header bg-white" style="cursor: pointer;" data-bs-toggle="collapse"
      data-bs-target="#paymentInfoCollapse" aria-expanded="false" aria-controls="paymentInfoCollapse">
      <h5 class="mb-0">
        <i class="bi bi-credit-card-2-back me-2"></i>
        Payment Information
        <i class="bi bi-chevron-down float-end"></i>
      </h5>
    </div>

    <div class="collapse" id="paymentInfoCollapse">
      <div class="card-body">
        {{!-- Payment Summary --}}
        <div class="payment-summary">
          <div class="row mb-2">
            <div class="col-7 text-muted">Total Amount:</div>
            <div class="col-5 text-end fw-bold">{{formatCurrency order.totalAmount}}</div>
          </div>

          {{#if (gt order.paidAmount 0)}}
          <div class="row mb-2">
            <div class="col-7 text-muted">
              <i class="bi bi-check-circle-fill text-success me-1"></i>
              Amount Paid:
            </div>
            <div class="col-5 text-end text-success fw-bold">
              {{formatCurrency order.paidAmount}}
            </div>
          </div>
          {{/if}}

          {{#if (gt order.remainingAmount 0)}}
          <div class="row mb-2">
            <div class="col-7 text-muted">
              <i class="bi bi-exclamation-circle-fill text-danger me-1"></i>
              Remaining:
            </div>
            <div class="col-5 text-end text-danger fw-bold">
              {{formatCurrency order.remainingAmount}}
            </div>
          </div>
          {{/if}}

          {{!-- Payment Progress Bar --}}
          {{#if (isPartiallyPaid order)}}
          <div class="progress mt-3" style="height: 20px;">
            <div class="progress-bar bg-success" role="progressbar"
              aria-valuenow="{{paymentPercentage order.paidAmount order.totalAmount}}" aria-valuemin="0"
              aria-valuemax="100">
              {{paymentPercentage order.paidAmount order.totalAmount}}% Paid
            </div>
          </div>
          {{/if}}
        </div>

        <hr class="my-3">

        {{!-- Payment Status Badge --}}
        <div class="mb-3">
          <span class="badge {{paymentStatusBadge order.paymentStatus}} p-2 fs-6">
            <i class="{{paymentStatusIcon order.paymentStatus}} me-1"></i>
            {{order.paymentStatus}}
          </span>
        </div>
        {{#if (amountCheck order.remainingAmount)}}
        {{!-- Payment Button --}}
        {{#unless (isFullyPaid order)}}
        {{#if (gt order.remainingAmount 0)}}
        <button class="btn btn-primary btn-lg w-100 btn-pay mb-3" onclick="payment(this)"
          data-payment="{{order.paymentMethod}}" data-totalamount="{{order.remainingAmount}}"
          data-orderid="{{order._id}}" data-customername="{{order.address.name}}">
          <i class="{{paymentMethodIcon order.paymentMethod}} me-2"></i>
          {{#if (gt order.paidAmount 0)}}
          Pay Remaining {{formatCurrency order.remainingAmount}}
          {{else}}
          Pay Now {{formatCurrency order.totalAmount}}
          {{/if}}
        </button>
        {{/if}}
        {{else}}
        {{#if (eq order.paymentStatus "Cancelled")}}
        {{else}}
        {{!-- Fully Paid Message --}}
        <div class="alert alert-success mb-3">
          <i class="bi bi-check-circle-fill me-2"></i>
          <strong>Payment Completed!</strong> This order has been fully paid.
        </div>\
        {{/if}}
        {{/unless}}
        {{else}}
        <div class="alert alert-warnig mb-3">
          <i class="bi bi-check-circle-fill me-2"></i>
          <strong>Remaining balance can be paid after delivery</strong>
        </div>
        {{/if}}

        {{!-- Payment Method Info --}}
        <div class="payment-method-info p-3 bg-light rounded">
          <div class="row">
            <div class="col-6">
              <small class="text-muted d-block">Payment Method</small>
              <span class="fw-bold">
                <i class="{{paymentMethodIcon order.paymentMethod}} me-1"></i>
                {{order.paymentMethod}}
              </span>
            </div>
            <div class="col-6 text-end">
              <small class="text-muted d-block">Order Date</small>
              <span class="fw-bold">{{formatDateShort order.createdAt}}</span>
            </div>
          </div>
        </div>

        {{!-- Payment Transaction History --}}
        {{#if order.paymentTransactions}}
        {{#if (gt (length order.paymentTransactions) 0)}}
        <div class="mt-4">
          <h6 class="mb-3">
            <i class="bi bi-clock-history me-2"></i>
            Payment History
          </h6>
          <div class="payment-history">
            {{#each order.paymentTransactions}}
            {{#if (eq this.status "succeeded")}}
            <div
              class="transaction-item d-flex justify-content-between align-items-start p-3 mb-2 bg-light rounded border">
              <div class="flex-grow-1">
                <div class="d-flex align-items-center mb-1">
                  {{#if (eq this.type "advance")}}
                  <span class="badge bg-info me-2">
                    <i class="bi bi-cash-coin"></i> Advance
                  </span>
                  {{else if (eq this.type "remaining")}}
                  <span class="badge bg-warning text-dark me-2">
                    <i class="bi bi-wallet2"></i> Remaining
                  </span>
                  {{else}}
                  <span class="badge bg-success me-2">
                    <i class="bi bi-credit-card"></i> Full
                  </span>
                  {{/if}}
                  <small class="text-muted">{{formatDate this.paidAt}}</small>
                </div>
                {{#if this.paymentIntentId}}
                <small class="text-muted d-block">
                  <i class="bi bi-receipt me-1"></i>
                  ID: {{this.paymentIntentId}}
                </small>
                {{/if}}
              </div>
              <div class="text-end">
                <strong class="text-success fs-5">{{formatCurrency this.amount}}</strong>
              </div>
            </div>
            {{/if}}
            {{/each}}
          </div>
        </div>
        {{/if}}
        {{/if}}
      </div>
    </div>
  </div>


  <!-- ITEMS -->
  <div style="display: flex;justify-content: space-between;">
    <h5 class="section-title">Order Items</h5>
  </div>


  <div class="item-box">
    {{#each order.items}}
    <div class="user-item-row">

      <!-- LEFT IMAGE -->
      <div class="user-item-image">
        {{#if this.carId}}
        <img src="{{this.variantId.image_url.[0]}}">
        {{else}}
        <img src="{{this.accessoryId.images.[0]}}">
        {{/if}}
      </div>

      <!-- CENTER INFO -->
      <div class="user-item-info">

        <div class="user-item-title">
          {{#if this.carId}}{{this.carId.name}}{{else}}{{this.accessoryId.name}}{{/if}}
        </div>

        <div class="user-item-meta">Qty {{this.quantity}}</div>

        <!-- PRICE BREAKDOWN -->
        <div class="item-price-box">

          <div class="price-row">
            <span>Unit Price</span>
            <span>₹ {{formatPrice this.price}}</span>
          </div>
          {{#if this.offerPrice}}
          <div class="price-row offer">
            <span>Unit Offer Price</span>
            <span>₹ {{formatPrice this.offerPrice}}</span>
          </div>
          {{/if}}

          {{#if this.advanceAmount}}
          <div class="price-row advance">
            <span>Advance Paid</span>
            <span>₹ {{formatPrice this.advanceAmount}}</span>
          </div>
          {{/if}}
          <div class="price-row">
            <span>Tax</span>
            <span>₹ {{formatPrice this.accessoryTax}}</span>
          </div>
          <div class="price-row">
            <span>Total Per item</span>
            <span>₹ {{formatPrice this.totalItemAmount}}</span>
          </div>

          {{#if this.offerPrice}}
          <div class="price-row offer">
            <span>Offer Price</span>
            <span>₹ {{formatPrice this.offerPrice}}</span>
          </div>
          {{/if}}

          {{#if this.advanceAmount}}
          <div class="price-row advance">
            <span>Advance Paid</span>
            <span>₹ {{formatPrice this.advanceAmount}}</span>
          </div>
          {{/if}}

          {{#if this.cancel.approvedAt}}
          <div class="price-row refund">
            <span>Cancelled</span>
            <span>- ₹ {{formatPrice this.cancel.refundAmount}}</span>
          </div>
          {{/if}}



          {{#if this.return.approvedAt}}
          <div class="price-row refund">
            <span>Refunded (Returned)</span>
            <span>- ₹ {{formatPrice this.return.refundAmount}}</span>
          </div>
          {{/if}}

        </div>


        <!-- ORDER PROGRESS -->
        <div class="order-progress
      {{#if this.cancel.approvedAt}}is-cancelled{{/if}}
      {{#if this.return.approvedAt}}is-returned{{/if}}
    ">

          <div class="progress-track">
            <div class="progress-fill
          {{#if this.fulfillmentStatus.confirmedAt}}confirmed{{/if}}
          {{#if this.fulfillmentStatus.shippedAt}}shipped{{/if}}
          {{#if this.fulfillmentStatus.out_for_deliveryAt}}out_for_delivery{{/if}}
          {{#if this.fulfillmentStatus.deliveredAt}}delivered{{/if}}
        "></div>
          </div>

          <div class="progress-steps">

            <div class="step done">
              <div class="step-dot"></div>
              <div class="step-label">Placed</div>
              <div class="step-date">{{formattedDate this.fulfillmentStatus.placedAt}}</div>
            </div>

            <div class="step {{#if this.fulfillmentStatus.confirmedAt}}done{{/if}}">
              <div class="step-dot"></div>
              <div class="step-label">Confirmed</div>
              {{#if this.fulfillmentStatus.confirmedAt}}
              <div class="step-date">{{formattedDate this.fulfillmentStatus.confirmedAt}}</div>
              {{/if}}
            </div>

            <div class="step {{#if this.fulfillmentStatus.shippedAt}}done{{/if}}">
              <div class="step-dot"></div>
              <div class="step-label">Shipped</div>
              {{#if this.fulfillmentStatus.shippedAt}}
              <div class="step-date">{{formattedDate this.fulfillmentStatus.shippedAt}}</div>
              {{/if}}
            </div>

            <div class="step {{#if this.fulfillmentStatus.out_for_deliveryAt}}done{{/if}}">
              <div class="step-dot"></div>
              <div class="step-label">Out for Delivery</div>
              {{#if this.fulfillmentStatus.out_for_deliveryAt}}
              <div class="step-date">{{formattedDate this.fulfillmentStatus.out_for_deliveryAt}}</div>
              {{/if}}
            </div>

            {{#if this.cancel.approvedAt}}
            <div class="step done cancelled">
              <div class="step-dot"></div>
              <div class="step-label">Cancelled</div>
              <div class="step-date">{{formattedDate this.cancel.approvedAt}}</div>
            </div>
            {{else if this.return.approvedAt}}
            <div class="step done returned">
              <div class="step-dot"></div>
              <div class="step-label">Returned</div>
              <div class="step-date">{{formattedDate this.return.approvedAt}}</div>
            </div>
            {{else}}
            <div class="step {{#if this.fulfillmentStatus.deliveredAt}}done{{/if}}">
              <div class="step-dot"></div>
              <div class="step-label">Delivered</div>
              {{#if this.fulfillmentStatus.deliveredAt}}
              <div class="step-date">{{formattedDate this.fulfillmentStatus.deliveredAt}}</div>
              {{/if}}
            </div>
            {{/if}}

          </div>
        </div>
      </div>

      <!-- RIGHT SIDE -->
      <div class="item-right">

        {{#if this.return.approvedAt}}
        <button class="item-action-btn return" disabled>Return Approved</button>

        {{else if this.return.rejectedAt}}
        <button class="item-action-btn return" disabled>Return Rejected</button>

        {{else if this.return.requested}}
        <button class="item-action-btn return" disabled>Return Requested</button>

        {{else if (eq this.fulfillmentStatus.status "delivered")}}
        {{#if this.carId}}
        <button class="item-action-btn return" disabled>No Return</button>
        {{else}}
        <button class="item-action-btn return" data-orderid="{{../order._id}}" data-itemid="{{this._id}}"
          data-bs-toggle="modal" data-bs-target="#returnModal">
          Return
        </button>
        {{/if}}

        {{else if this.cancel.approvedAt}}
        <button class="item-action-btn cancel" disabled>Cancelled</button>

        {{else if this.cancel.rejectedAt}}
        <button class="item-action-btn cancel" disabled>Cancel Rejected</button>

        {{else if this.cancel.requested}}
        <button class="item-action-btn cancel" disabled>Cancel Requested</button>

        {{else if (eq this.fulfillmentStatus.status "out_for_delivery")}}
        <button class="item-action-btn cancel" disabled>Cancel</button>

        {{else}}
        <button class="item-action-btn cancel" data-orderid="{{../order._id}}" data-itemid="{{this._id}}"
          data-bs-toggle="modal" data-bs-target="#cancelModal">
          Cancel
        </button>
        {{/if}}

        <!-- FINAL ITEM TOTAL -->
        <!-- <div class="user-item-price">
          {{#if this.offerPrice}}
          ₹ {{formatPrice this.offerPrice}}
          {{else}}
          ₹ {{formatPrice this.price}}
          {{/if}}
        </div> -->

      </div>

    </div>
    {{/each}}

  </div>




  <!-- TRACKING -->
  <!-- <h5 class="section-title">Tracking History</h5>
  <div class="tracking-box">
    <div class="track-step">
      <div class="track-dot"></div>
      <div>
        <div class="track-title">Order Placed</div>
        <div class="track-date">{{formattedDate order.createdAt}}</div>
      </div>
    </div>

    {{#if order.deliveredAt}}
    <div class="track-step">
      <div class="track-dot"></div>
      <div>
        <div class="track-title">Delivered</div>
        <div class="track-date">{{formattedDate order.deliveredAt}}</div>
      </div>
    </div>
    {{else}}
    <p class="text-muted small">More tracking updates will appear here.</p>
    {{/if}}
  </div> -->
</div>

<!-- Return order -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <h5>Product Return</h5>

        <form id="returnForm" class="mt-3">
          <div class="mb-3">
            <label class="form-label">Subject</label>
            <input class="form-control" name="subject" placeholder="subject">
            <small class="text-danger error-subject d-none">Subject is required</small>
          </div>

          <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea class="form-control" rows="6" name="message"></textarea>
            <small class="text-danger error-message d-none">Message is required</small>
          </div>

          <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-dark">
              <i class="bi bi-send"></i> Request
            </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>
<!-- cancel order -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body">
        <h5>Product Cancel</h5>

        <form id="cancelForm" class="mt-3">
          <div class="mb-3">
            <label class="form-label">Subject</label>
            <input class="form-control" name="subject">
            <small class="text-danger error-subject d-none">Subject is required</small>
          </div>

          <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea class="form-control" rows="6" name="message"></textarea>
            <small class="text-danger error-message d-none">Message is required</small>
          </div>

          <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-dark">
              <i class="bi bi-send"></i> Request
            </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content text-center p-3">
      <h5 class="mb-2">Request Sent</h5>
      <p class="text-muted mb-2" id="responsMsg"></p>
      <i class="bi bi-check-circle-fill text-success" style="font-size:32px;"></i>
    </div>
  </div>
</div>

<!-- Success Modal -->
<div class="modal-overlay" id="paymentSuccessModal">
  <div class="modal-container">
    <div class="modal-icon-wrapper success">
      <div class="modal-icon">✓</div>
    </div>
    <h5 class="modal-title success" id="successTitle">Payment Successful!</h5>
    <p class="modal-message" id="successMessage">Your order has been placed successfully</p>
    <button class="modal-btn success" onclick="closeSuccessModal()">Continue</button>
  </div>
</div>

<!-- Error Modal -->
<div class="modal-overlay" id="paymentErrorModal">
  <div class="modal-container">
    <div class="modal-icon-wrapper error">
      <div class="modal-icon">✕</div>
    </div>
    <h5 class="modal-title error" id="errorTitle">Payment Failed</h5>
    <p class="modal-message" id="errorMessage">Something went wrong. Please try again.</p>
    <button class="modal-btn error" onclick="closeErrorModal()">Try Again</button>
  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script src="/js/user/account/orderDetail.js"></script>