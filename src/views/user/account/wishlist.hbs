<link rel="stylesheet" href="/css/user/account/wishlist.css">
<!-- Slide-in Toast MSG -->
<div id="mobileAlert" class="mobile-alert"></div>

<div class="wrap-wishlist">
  <section id="wishlist" class="main-card mt-4">
    <h5>Wishlist</h5>

    <div class="wishlist-grid">
      {{#if wishlist.items.length}}
      {{#each wishlist.items}}
      <div class="wishlist-card">

        <!-- Full-width image banner -->
        <div class="card-img-wrap">
          {{#if this.variantId}}
          <img src="{{this.variantId.image_url.[0]}}" alt="car">
          {{else}}
          <img src="{{this.accessoryId.images.[0]}}" alt="accessory">
          {{/if}}
        </div>

        <!-- Body: name, price, actions -->
        <div class="card-body">
          <div>
            {{#if this.variantId}}
            <h6>{{this.carId.name}}</h6>
            <div class="price-tag">₹ {{formatPrice this.variantId.price}}</div>
            {{else}}
            <h6>{{this.accessoryId.name}}</h6>
            <div class="price-tag">₹ {{formatPrice this.accessoryId.price}}</div>
            {{/if}}
          </div>

          <div class="card-actions">
            {{#if this.variantId}}
            <a href="/cars-collection/view-car-product/{{this.carId._id}}" class="btn btn-dark btn-sm">View Details</a>
            {{else}}
            <a href="/all-accessories/view-accessory-product/{{this.accessoryId._id}}" class="btn btn-dark btn-sm">View
              Details</a>
            {{/if}}
            <!-- class only, no id — delegation handles the click -->
            <button data-itemid="{{this._id}}" class="btn btn-link btn-sm btn-remove-wishlist">Remove</button>
          </div>
        </div>

      </div>
      {{/each}}

      {{else}}
      <!-- Empty state (uses .empty-wishlist styles already in wishlist.css) -->
      <div class="empty-wishlist" style="grid-column: 1 / -1;">
        <div class="empty-icon">🛒</div>
        <h6>Your wishlist is empty</h6>
        <p>Save your favourite cars and accessories here so you can find them again quickly.</p>
        <a href="/cars-collection" class="btn btn-dark">Browse Cars</a>
      </div>
      {{/if}}
    </div>

  </section>
</div>
<script src="/js/user/account/wishlist.js"></script>