<link rel="stylesheet" href="/css/user/checkout/checkout.css">
<link rel="stylesheet" href="/css/user/checkout/checkout_Step_2_Select_Payment.css">

<div class="wrap-container">
  <div class="container">
    <h1>Checkout</h1>

    <!-- Stepper -->
    <div class="stepper-wrapper">
      <div class="stepper">
        <div class="step-item">
          <div class="step active-step">1</div>
          <div class="step-label">Address</div>
        </div>
        <div class="step-connector done"></div>
        <div class="step-item">
          <div class="step active-step">2</div>
          <div class="step-label">Payment</div>
        </div>
        <div class="step-connector"></div>
        <div class="step-item">
          <div class="step">3</div>
          <div class="step-label">Summary</div>
        </div>
      </div>
    </div>

    <!-- Important notice (amount > 9,99,999) -->
    {{#unless (amountCheck cart.totalAfterAll)}}
    <div class="important-notice">
      <div class="notice-header">
        <span class="notice-icon">⚠️</span>
        <h3 class="notice-title">Important Payment Notice</h3>
      </div>
      <div class="notice-content">
        <p><strong>Your order total exceeds ₹9,99,999</strong></p>
        <ul class="notice-list">
          <li>Full payment through online methods is <strong>not possible</strong> for orders above ₹9,99,999</li>
          <li>You can pay an <strong>advance amount of ₹1,000</strong> to confirm your order</li>
          <li><strong>No refund policy:</strong> If you cancel the order after payment, the advance amount of ₹1,000
            will <strong>NOT be refunded</strong></li>
          <li>Remaining balance can be paid after delivery</li>
          {{#if cart.carTotal}}
          <li><strong>No return or exchange policy:</strong> Cars once purchased are <strong>not eligible for return or
              exchange</strong></li>
          {{/if}}
        </ul>
      </div>
    </div>
    {{/unless}}

    <!-- Grid -->
    <div class="grid">

      <!-- LEFT – Payment Methods -->
      <div>
        <h2>Payment Method</h2>
        <div class="card">

          <!-- Stripe form (hidden until clicked) -->
          <div id="stripe-box" style="display:none;">
            <h5>Secure Payment</h5>
            <div class="stripe-amount-wrap">
              <span class="stripe-label">Amount to Pay:</span>
              <span class="stripe-value" id="stripe-amount">₹0</span>
            </div>
            <div id="payment-element"></div>
            <button id="stripe-submit-btn" type="button">
              <span id="btn-text">Pay Now</span>
              <span id="btn-amount" style="margin-left:8px; font-weight:700;"></span>
            </button>
          </div>

          <!-- Stripe option -->
          <div class="payment-option" onclick="payment(this)" data-payment="STRIPE" data-cartid="{{cart._id}}" {{#if
            (amountCheck cart.totalAfterAll)}} data-totalamount="{{cart.totalAfterAll}}" {{else}}
            data-totalamount="{{cart.totalAdvanceAmount}}" {{/if}}>
            <i class="bi bi-stripe" style="font-size:24px; color:#000;"></i>
            <div>
              <strong>STRIPE</strong>
              <small>Pay instantly</small>
            </div>
          </div>

          <!-- COD option -->
          <div class="payment-option" onclick="openCodConfirmModal(this)" data-payment="COD" data-cartid="{{cart._id}}">
            <i class="bi bi-cash-stack" style="font-size:24px; color:#0b0b0b;"></i>
            <div><strong>Cash on Delivery</strong></div>
          </div>

          <!-- Wallet option -->
          <div class="payment-option" onclick="openWalletConfirmModal(this)" data-payment="WALLET"
            data-cartid="{{cart._id}}" {{#if (amountCheck cart.totalAfterAll)}}
            data-totalamount="{{cart.totalAfterAll}}" {{else}} data-totalamount="{{cart.totalAdvanceAmount}}" {{/if}}>
            <i class="bi bi-wallet2" style="font-size:24px; color:#0b0b0b;"></i>
            <div><strong>Wallet</strong></div>
          </div>

        </div>
      </div>

      <!-- RIGHT – Order Summary -->
      <div>
        <div class="card summary-card">
          <h3>Order Summary</h3>

          <div class="summary-row"><span>Price ({{cart.items.length}} items)</span><span>{{formatPrice
              cart.totalAmount}}</span></div>
          <div class="summary-row"><span>Shipping</span><span>Free</span></div>

          {{#if cart.accessoryTax}}
          <div class="summary-row">
            <span>Tax <span class="fw-semibold">(GST {{taxRate}}% Only for Accessory)</span></span>
            <span>₹ {{formatPrice cart.accessoryTax}}</span>
          </div>
          {{else}}
          <div class="summary-row"><span>Tax</span><span>₹ 0</span></div>
          {{/if}}

          {{#if cart.appliedCoupon.code}}
          <div class="coupon-pill">
            <span>Applied Coupon: <span class="code">{{cart.appliedCoupon.code}}</span></span>
            <span class="saving">− ₹ {{formatPrice cart.appliedCoupon.couponDiscount}}</span>
          </div>
          {{/if}}

          <hr class="summary-divider">

          <div class="summary-row total">
            <span class="label">Total</span>
            <span class="value">₹ {{formatPrice cart.totalAfterAll}}</span>
          </div>

          {{#if cart.discountedPrice}}
          <div class="savings-banner">
            <span>🎉 Your Total Savings</span>
            <span>₹ {{formatPrice cart.discountedPrice}}</span>
          </div>
          {{/if}}
        </div>
      </div>

    </div>
  </div>
</div>

<!-- ===== SUCCESS MODAL ===== -->
<div class="co-overlay" id="successModal">
  <div class="co-modal">
    <div class="co-icon-wrap success"><span class="co-icon">✓</span></div>
    <h5 class="success" id="successTitle">Payment Successful!</h5>
    <p class="co-message" id="successMessage">Your order has been placed successfully</p>
    <button class="co-btn co-btn-success co-btn-single" onclick="closeSuccessModal()">Continue</button>
  </div>
</div>

<!-- ===== ERROR MODAL ===== -->
<div class="co-overlay" id="errorModal">
  <div class="co-modal">
    <div class="co-icon-wrap error"><span class="co-icon">✕</span></div>
    <h5 class="error" id="errorTitle">Payment Failed</h5>
    <p class="co-message" id="errorMessage">Something went wrong. Please try again.</p>
    <button class="co-btn co-btn-error co-btn-single" onclick="closeErrorModal()">Try Again</button>
  </div>
</div>

<!-- ===== COD CONFIRM MODAL ===== -->
<div class="co-overlay" id="codConfirmModal">
  <div class="co-modal">
    <div class="co-icon-wrap warning"><span class="co-icon">!</span></div>
    <h5 class="warning">Confirm Cash on Delivery</h5>
    <div class="co-message">
      You chose <strong>Cash on Delivery</strong>.<br>
      Please confirm to place your order.
    </div>
    <div class="co-actions">
      <button class="co-btn co-btn-error" onclick="closeCodConfirmModal()">Cancel</button>
      <button class="co-btn co-btn-success" onclick="confirmCOD()">Confirm Order</button>
    </div>
  </div>
</div>

<!-- ===== WALLET CONFIRM MODAL ===== -->
<div class="co-overlay" id="walletConfirmModal">
  <div class="co-modal">
    <div class="co-icon-wrap wallet"><span class="co-icon">💳</span></div>
    <h5 class="wallet">Confirm Wallet Payment</h5>
    <div class="co-message">
      <p>You are about to pay <strong id="walletAmount">₹0</strong> from your wallet.<br>
        Please confirm to proceed with the payment.</p>
      <div class="co-balance-box">
        <span class="co-balance-label">Current Wallet Balance:</span>
        <span class="co-balance-value" id="walletBalance">Loading...</span>
      </div>
    </div>
    <div class="co-actions">
      <button class="co-btn co-btn-error" onclick="closeWalletConfirmModal()">Cancel</button>
      <button class="co-btn co-btn-success" id="confirmWalletBtn" onclick="confirmWallet()">Confirm Payment</button>
    </div>
  </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script src="https://js.stripe.com/v3/"></script>
<script src="/js/user/checkout/checkout_Step_2_Select_Payment.js"></script>