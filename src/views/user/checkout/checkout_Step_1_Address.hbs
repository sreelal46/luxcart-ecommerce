<link rel="stylesheet" href="/css/user/checkout/checkout.css">
<link
  href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap"
  rel="stylesheet" />


<!-- ===== PAGE ===== -->
<div class="wrap-container">

  <h1>Checkout</h1>

  <!-- Stepper -->
  <div class="stepper-wrapper">
    <div class="stepper">
      <div class="step-item active">
        <div class="step active-step">1</div>
        <div class="step-label">Address</div>
      </div>
      <div class="step-connector done"></div>
      <div class="step-item">
        <div class="step">2</div>
        <div class="step-label">Payment</div>
      </div>
      <div class="step-connector"></div>
      <div class="step-item">
        <div class="step">3</div>
        <div class="step-label">Summary</div>
      </div>
    </div>
  </div>

  <!-- Grid -->
  <div class="grid">

    <!-- LEFT – Addresses -->
    <div>
      <div class="card">
        <h2>Delivery Address</h2>
        <a href="/account/addresses/add-address?from=checkout&cartId={{cartId}}" class="add-address-btn">+ Add
          Address</a>

        {{#each address}}
        <div class="address-card {{#if this.defaultAddress}}selected{{/if}}">
          <input type="radio" name="selectedAddress" value="{{this._id}}" {{#if this.defaultAddress}}checked{{/if}} />

          <div class="address-content">
            <div class="address-title">
              <span class="dot"></span>
              <strong>{{this.fullName}}</strong>
              <span class="default-badge">{{this.label}}</span>
            </div>
            <p class="address-text">
              {{this.landmark}} {{this.street}}<br>
              <small>Phone:</small> {{this.phone}}&nbsp;&nbsp;
              <small>PIN:</small> {{this.pinCode}}
            </p>
          </div>

          <span class="checkmark"></span>
        </div>
        {{/each}}
      </div>
    </div>

    <!-- RIGHT – Order Summary -->
    <div>
      <div class="card">
        <h3>Order Summary</h3>

        <div class="summary-row">
          <span class="label">Price ({{cart.items.length}} items)</span>
          <span class="value">₹ {{formatPrice cart.totalAmount}}</span>
        </div>
        <div class="summary-row">
          <span class="label">Shipping</span>
          <span class="value" style="color: var(--success-txt);">Free</span>
        </div>

        {{#if cart.accessoryTax}}
        <div class="summary-row">
          <span class="label">Tax <span style="font-size:11px;color:var(--muted);font-weight:500;">(GST {{taxRate}}% –
              Accessory)</span></span>
          <span class="value">₹ {{formatPrice cart.accessoryTax}}</span>
        </div>
        {{else}}
        <div class="summary-row">
          <span class="label">Tax</span>
          <span class="value">₹ 0</span>
        </div>
        {{/if}}

        {{#if cart.appliedCoupon.code}}
        <div class="coupon-pill">
          <span>Applied Coupon: <span class="code">{{cart.appliedCoupon.code}}</span></span>
          <span class="saving">− ₹ {{formatPrice cart.appliedCoupon.couponDiscount}}</span>
        </div>
        {{/if}}

        <hr class="summary-divider" />

        <div class="summary-row total">
          <span class="label">Total</span>
          <span class="value">₹ {{formatPrice cart.totalAfterAll}}</span>
        </div>

        {{#if cart.discountedPrice}}
        <div class="savings-banner">
          <span>🎉 Your Total Savings</span>
          <span>₹ {{formatPrice cart.discountedPrice}}</span>
        </div>
        {{/if}}

        <button class="btn-continue" id="continueBtn">Continue</button>
      </div>
    </div>

  </div>
</div>

<!-- ===== ERROR MODAL (all classes prefixed with co-) ===== -->
<div class="co-overlay" id="coOverlay">
  <div class="co-modal">
    <button class="co-modal-close" id="coModalClose">&times;</button>

    <div class="co-modal-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linecap="round"
        stroke-linejoin="round">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
    </div>

    <h3>No Address Selected</h3>
    <p>Please select a delivery address or add a new one before continuing with your order.</p>

    <div class="co-modal-actions">
      <button class="co-btn co-btn-primary" id="coAddAddress">+ Add Address</button>
      <button class="co-btn co-btn-ghost" id="coCloseModal">Cancel</button>
    </div>
  </div>
</div>

<!-- ===== SCRIPT ===== -->
<script src="/js/user/checkout/checkout_Step_1_Address.js"></script>